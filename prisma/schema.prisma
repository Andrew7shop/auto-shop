// Prisma schema for the auto repair shop management app
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CustomerType {
  INDIVIDUAL
  BUSINESS
}

model Customer {
  id           String       @id @default(cuid())
  customerType CustomerType @default(INDIVIDUAL)
  firstName    String
  lastName     String
  businessName String?
  email        String?
  phone        String?
  address      String?
  birthday     DateTime?    @db.Date
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  sourceId String?
  source   MarketingSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  vehicles     Vehicle[]
  workOrders   WorkOrder[]
  appointments Appointment[]
  invoices     Invoice[]

  @@index([lastName, firstName])
  @@index([sourceId])
}

model Vehicle {
  id           String  @id @default(cuid())
  vin          String? @unique
  make         String
  model        String
  year         Int
  licensePlate String?
  color        String?
  mileage      Int?
  notes        String?

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  workOrders   WorkOrder[]
  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
}

enum WorkOrderStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_PARTS
  WAITING_ON_APPROVAL
  COMPLETED
  CANCELLED
}

model JobCategory {
  id        String  @id @default(cuid())
  code      String  @unique
  name      String
  active    Boolean @default(true)
  sortOrder Int     @default(0)

  workOrders WorkOrder[]
  cannedJobs CannedJob[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
}

enum EmployeeRole {
  TECHNICIAN
  ADVISOR
  MANAGER
  OTHER
}

enum ArrivalType {
  WAITING
  DROP_OFF
  TOWED_IN
}

model MarketingSource {
  id        String  @id @default(cuid())
  name      String  @unique
  active    Boolean @default(true)
  sortOrder Int     @default(0)

  workOrders WorkOrder[]
  customers  Customer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
}

model Employee {
  id        String       @id @default(cuid())
  firstName String
  lastName  String
  role      EmployeeRole @default(TECHNICIAN)
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  workOrders WorkOrder[]

  @@index([role, active])
}

model WorkOrder {
  id          String          @id @default(cuid())
  number      Int             @unique @default(autoincrement())
  status      WorkOrderStatus @default(OPEN)
  description String
  odometer    Int?

  categoryId String?
  category   JobCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  assignedToId String?
  assignedTo   Employee? @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  arrivalType ArrivalType?

  laborRateId String?
  laborRate   LaborRate? @relation(fields: [laborRateId], references: [id], onDelete: SetNull)

  marketingSourceId String?
  marketingSource   MarketingSource? @relation(fields: [marketingSourceId], references: [id], onDelete: SetNull)

  lineItems   LineItem[]
  invoice     Invoice?
  appointment Appointment?

  openedAt    DateTime  @default(now())
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([customerId])
  @@index([vehicleId])
  @@index([status])
  @@index([laborRateId])
  @@index([marketingSourceId])
  @@index([assignedToId])
  @@index([categoryId])
}

enum LineItemType {
  LABOR
  PART
  FEE
}

model LineItem {
  id          String       @id @default(cuid())
  type        LineItemType
  description String
  quantity    Decimal      @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal      @db.Decimal(10, 2)

  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  partId String?
  part   Part?   @relation(fields: [partId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workOrderId])
  @@index([partId])
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  VOID
}

enum DiscountType {
  PERCENT
  FIXED
}

model Invoice {
  id            String        @id @default(cuid())
  number        Int           @unique @default(autoincrement())
  status        InvoiceStatus @default(UNPAID)
  taxRate       Decimal       @default(0) @db.Decimal(5, 4)
  discountType  DiscountType  @default(FIXED)
  discountValue Decimal       @default(0) @db.Decimal(10, 2)
  tireFeeTotal  Decimal       @default(0) @db.Decimal(10, 2)

  workOrderId String    @unique
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Restrict)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  payments Payment[]

  issuedAt  DateTime  @default(now())
  dueAt     DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([customerId])
  @@index([status])
}

enum PaymentMethod {
  CASH
  CARD
  CHECK
  BANK_TRANSFER
  OTHER
}

enum PaymentStatus {
  SUCCEEDED
  DECLINED
}

model Payment {
  id        String        @id @default(cuid())
  amount    Decimal       @db.Decimal(10, 2)
  method    PaymentMethod
  status    PaymentStatus @default(SUCCEEDED)
  reference String?
  paidAt    DateTime      @default(now())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@index([status])
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  NO_SHOW
  CANCELLED
}

model Appointment {
  id       String            @id @default(cuid())
  startsAt DateTime
  endsAt   DateTime
  status   AppointmentStatus @default(SCHEDULED)
  notes    String?

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  workOrderId String?    @unique
  workOrder   WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: SetNull)

  appointmentTypeId String?
  appointmentType   AppointmentType? @relation(fields: [appointmentTypeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([startsAt])
  @@index([appointmentTypeId])
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model AppointmentSettings {
  id        String    @id @default("appointments")
  openHour  Int       @default(8)
  closeHour Int       @default(17)
  daysOpen  Weekday[] @default([MONDAY, TUESDAY, WEDNESDAY, THURSDAY, FRIDAY])

  updatedAt DateTime @updatedAt
}

model AppointmentType {
  id                     String  @id @default(cuid())
  name                   String
  defaultDurationMinutes Int     @default(60)
  color                  String  @default("blue")
  active                 Boolean @default(true)

  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

model Vendor {
  id          String  @id @default(cuid())
  name        String
  contactName String?
  email       String?
  phone       String?
  address     String?
  notes       String?

  parts  Part[]
  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

enum PartCategory {
  PART
  TIRE
  BATTERY
}

model Part {
  id             String       @id @default(cuid())
  sku            String?      @unique
  name           String
  description    String?
  category       PartCategory @default(PART)
  quantityOnHand Int          @default(0)
  reorderPoint   Int          @default(0)
  unitCost       Decimal      @default(0) @db.Decimal(10, 2)
  unitPrice      Decimal      @default(0) @db.Decimal(10, 2)

  vendorId String?
  vendor   Vendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  orderLineItems OrderLineItem[]
  lineItems      LineItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId])
  @@index([name])
  @@index([category])
}

enum OrderStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

model Order {
  id     String      @id @default(cuid())
  number Int         @unique @default(autoincrement())
  status OrderStatus @default(DRAFT)
  notes  String?

  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  lineItems OrderLineItem[]

  orderedAt  DateTime?
  expectedAt DateTime?
  receivedAt DateTime?
  paidAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([vendorId])
  @@index([status])
}

model OrderLineItem {
  id          String  @id @default(cuid())
  description String
  quantity    Int     @default(1)
  unitCost    Decimal @default(0) @db.Decimal(10, 2)

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  partId String?
  part   Part?   @relation(fields: [partId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([partId])
}

model CannedJob {
  id          String   @id @default(cuid())
  name        String
  description String?
  laborHours  Decimal? @db.Decimal(6, 2)
  price       Decimal  @default(0) @db.Decimal(10, 2)
  active      Boolean  @default(true)

  categoryId String?
  category   JobCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId, active])
  @@index([name])
}

model ShopProfile {
  id         String  @id @default("shop")
  name       String  @default("")
  shopId     String?
  ein        String?
  taxId      String?
  address    String?
  city       String?
  state      String?
  postalCode String?
  phone      String?

  updatedAt DateTime @updatedAt
}

model RoSettings {
  id                    String          @id @default("ro")
  defaultTaxRate        Decimal         @default(0) @db.Decimal(5, 4)
  defaultDiscountType   DiscountType    @default(FIXED)
  defaultDiscountValue  Decimal         @default(0) @db.Decimal(10, 2)
  defaultTireFee        Decimal         @default(0) @db.Decimal(10, 2)
  gpPerHourGoal         Decimal?        @db.Decimal(10, 2)
  invoiceNumberPrefix   String?
  invoiceNumberPadding  Int             @default(0)
  enabledPaymentMethods PaymentMethod[] @default([CASH, CARD, CHECK, BANK_TRANSFER, OTHER])

  showOdometerInOut      Boolean @default(true)
  showMarketingSource    Boolean @default(true)
  showTechOnLabor        Boolean @default(true)
  showJobCategory        Boolean @default(true)
  showPartsPurchaseOrder Boolean @default(true)
  showPartsBilling       Boolean @default(true)
  showPaymentCardType    Boolean @default(true)
  showTireDotCodes       Boolean @default(true)
  showDigitalSignature   Boolean @default(true)

  updatedAt DateTime @updatedAt
}

model LaborRate {
  id          String  @id @default(cuid())
  name        String
  ratePerHour Decimal @db.Decimal(10, 2)
  active      Boolean @default(true)

  workOrders WorkOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

model ShopFee {
  id     String       @id @default(cuid())
  name   String
  type   DiscountType @default(FIXED)
  value  Decimal      @db.Decimal(10, 2)
  active Boolean      @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

model MarkupSettings {
  id                 String  @id @default("markups")
  appliesToParts     Boolean @default(true)
  appliesToTires     Boolean @default(false)
  appliesToBatteries Boolean @default(false)

  updatedAt DateTime @updatedAt
}

model MarkupTier {
  id         String   @id @default(cuid())
  minCost    Decimal  @db.Decimal(10, 2)
  maxCost    Decimal? @db.Decimal(10, 2)
  multiplier Decimal  @db.Decimal(6, 3)
  active     Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, minCost])
}

model LaborMarkupTier {
  id         String   @id @default(cuid())
  minHours   Decimal  @db.Decimal(6, 2)
  maxHours   Decimal? @db.Decimal(6, 2)
  multiplier Decimal  @db.Decimal(6, 3)
  active     Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, minHours])
}

model EstimateInvoiceSettings {
  id              String @id @default("estimates-invoices")
  fieldVisibility Json   @default("{}")

  updatedAt DateTime @updatedAt
}

model CustomerSettings {
  id                  String  @id @default("customers")
  requireCustomerType Boolean @default(false)
  requireBusinessName Boolean @default(false)
  requireAddress      Boolean @default(false)
  requirePhone        Boolean @default(false)
  requireEmail        Boolean @default(false)
  requireSource       Boolean @default(false)
  requireBirthday     Boolean @default(false)

  updatedAt DateTime @updatedAt
}

enum IntegrationStatus {
  CONNECTED
  DISCONNECTED
}

model Integration {
  id          String            @id @default(cuid())
  name        String            @unique
  description String?
  status      IntegrationStatus @default(DISCONNECTED)
  apiKey      String?
  accountId   String?
  connectedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model BillingSettings {
  id            String @id @default("billing")
  currentPlanId String @default("free")

  updatedAt DateTime @updatedAt
}
