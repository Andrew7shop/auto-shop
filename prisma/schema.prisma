// Prisma schema for the auto repair shop management app
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Customer {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String?
  phone     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicles     Vehicle[]
  workOrders   WorkOrder[]
  appointments Appointment[]
  invoices     Invoice[]

  @@index([lastName, firstName])
}

model Vehicle {
  id           String  @id @default(cuid())
  vin          String? @unique
  make         String
  model        String
  year         Int
  licensePlate String?
  color        String?
  mileage      Int?
  notes        String?

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  workOrders   WorkOrder[]
  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
}

enum WorkOrderStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_PARTS
  WAITING_ON_APPROVAL
  COMPLETED
  CANCELLED
}

enum JobCategory {
  MAINTENANCE
  REPAIR
  TIRES
  INSPECTION
  DIAGNOSTIC
  OTHER
}

enum EmployeeRole {
  TECHNICIAN
  ADVISOR
  MANAGER
  OTHER
}

model Employee {
  id        String       @id @default(cuid())
  firstName String
  lastName  String
  role      EmployeeRole @default(TECHNICIAN)
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  workOrders WorkOrder[]

  @@index([role, active])
}

model WorkOrder {
  id          String          @id @default(cuid())
  number      Int             @unique @default(autoincrement())
  status      WorkOrderStatus @default(OPEN)
  category    JobCategory     @default(OTHER)
  description String
  odometer    Int?

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  assignedToId String?
  assignedTo   Employee? @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  lineItems   LineItem[]
  invoice     Invoice?
  appointment Appointment?

  openedAt    DateTime  @default(now())
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([customerId])
  @@index([vehicleId])
  @@index([status])
  @@index([assignedToId])
  @@index([category])
}

enum LineItemType {
  LABOR
  PART
  FEE
}

model LineItem {
  id          String       @id @default(cuid())
  type        LineItemType
  description String
  quantity    Decimal      @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal      @db.Decimal(10, 2)

  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  partId String?
  part   Part?   @relation(fields: [partId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workOrderId])
  @@index([partId])
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  VOID
}

enum DiscountType {
  PERCENT
  FIXED
}

model Invoice {
  id            String        @id @default(cuid())
  number        Int           @unique @default(autoincrement())
  status        InvoiceStatus @default(UNPAID)
  taxRate       Decimal       @default(0) @db.Decimal(5, 4)
  discountType  DiscountType  @default(FIXED)
  discountValue Decimal       @default(0) @db.Decimal(10, 2)
  tireFeeTotal  Decimal       @default(0) @db.Decimal(10, 2)

  workOrderId String    @unique
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Restrict)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  payments Payment[]

  issuedAt  DateTime  @default(now())
  dueAt     DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([customerId])
  @@index([status])
}

enum PaymentMethod {
  CASH
  CARD
  CHECK
  BANK_TRANSFER
  OTHER
}

model Payment {
  id        String        @id @default(cuid())
  amount    Decimal       @db.Decimal(10, 2)
  method    PaymentMethod
  reference String?
  paidAt    DateTime      @default(now())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([invoiceId])
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  NO_SHOW
  CANCELLED
}

model Appointment {
  id       String            @id @default(cuid())
  startsAt DateTime
  endsAt   DateTime
  status   AppointmentStatus @default(SCHEDULED)
  reason   String
  notes    String?

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  workOrderId String?    @unique
  workOrder   WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([startsAt])
}

model Vendor {
  id          String  @id @default(cuid())
  name        String
  contactName String?
  email       String?
  phone       String?
  address     String?
  notes       String?

  parts  Part[]
  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model Part {
  id             String  @id @default(cuid())
  sku            String? @unique
  name           String
  description    String?
  quantityOnHand Int     @default(0)
  reorderPoint   Int     @default(0)
  unitCost       Decimal @default(0) @db.Decimal(10, 2)
  unitPrice      Decimal @default(0) @db.Decimal(10, 2)

  vendorId String?
  vendor   Vendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  orderLineItems OrderLineItem[]
  lineItems      LineItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId])
  @@index([name])
}

enum OrderStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

model Order {
  id     String      @id @default(cuid())
  number Int         @unique @default(autoincrement())
  status OrderStatus @default(DRAFT)
  notes  String?

  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  lineItems OrderLineItem[]

  orderedAt  DateTime?
  expectedAt DateTime?
  receivedAt DateTime?
  paidAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([vendorId])
  @@index([status])
}

model OrderLineItem {
  id          String @id @default(cuid())
  description String
  quantity    Int    @default(1)
  unitCost    Decimal @default(0) @db.Decimal(10, 2)

  orderId String
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  partId String?
  part   Part?   @relation(fields: [partId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([partId])
}

model CannedJob {
  id          String      @id @default(cuid())
  name        String
  category    JobCategory @default(OTHER)
  description String?
  laborHours  Decimal?    @db.Decimal(6, 2)
  price       Decimal     @default(0) @db.Decimal(10, 2)
  active      Boolean     @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, active])
  @@index([name])
}

model ShopProfile {
  id            String  @id @default("shop")
  name          String  @default("")
  shopId        String?
  ein           String?
  taxId         String?
  address       String?
  city          String?
  state         String?
  postalCode    String?
  phone         String?

  updatedAt DateTime @updatedAt
}
